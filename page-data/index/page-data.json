tle":"Mastering","color":{"name":"neon-carrot"}}],"year":2021,"label":"Carpark Records","embed":{"embed":"<iframe style=\"border: 0; width: 170px; height: 170px;\" src=\"https://bandcamp.com/EmbeddedPlayer/album=1412675861/size=large/bgcol=ffffff/linkcol=0687f5/minimal=true/transparent=true/\" seamless><a href=\"https://cloudnothings.bandcamp.com/album/the-shadow-i-remember\">The Shadow I Remember by Cloud Nothings</a></iframe>"}}},{"node":{"album":"Flower of Devotion","band":"DEHD","featured":true,"categories":[{"title":"Mastering","color":{"name":"neon-carrot"}}],"year":2020,"label":"Firetalk Records","embed":{"embed":"<iframe style=\"border: 0; width: 170px; height: 170px;\" src=\"https://bandcamp.com/EmbeddedPlayer/album=1132302363/size=large/bgcol=ffffff/linkcol=0687f5/minimal=true/transparent=true/\" seamless><a href=\"http://dehdforever.bandcamp.com/album/flower-of-devotion\">Flower Of Devotion by DEHD</a></iframe>"}}}]},"allContentfulMe":{"edges":[{"node":{"name":"Greg Obis","intro":{"intro":"Hi, my name is Greg and I’m an audio engineer in Chicago, IL. In 2025, I took over the studio where I started out as an intern, [Chicago Mastering Service](https://chicagomasteringservice.com/). I’ve mastered albums for artists on labels like Sub Pop, Matador, ANTI-, Car Park, Captured Tracks, Hardly Art, Sacred Bones, Numero Group, Fire Talk, Winspear, Exploding in Sound and International Anthem to name a few. I track and mix records too. In addition to my studio work, I have traveled the country as a front of house engineer and tour manager for the likes of Jessica Pratt, Protomartyr, Yard Act, La Luz, and more. In my free time, I play guitar and sing in the band Stuck. This website showcases a limited discography of projects I’ve had the pleasure of working on. I would love to work on yours too!"},"tagline":"Cool guy with neat skills.","email":"gregobis@gmail.com"}}]}},"pageContext":{}},"staticQueryHashes":["3286242243","3292152004"],"slicesMap":{}}